#!/usr/bin/env bash
#
# Git Pre-Commit Hook - Documentation Freshness Check
#
# The check itself lives in lib/doc-check.sh so that repositories which wrap it
# in extra gates can source the same logic instead of copying it. Install with
# install-git-hooks.sh rather than by hand.

set -e

# Locate the shared library. A symlinked hook resolves it next to the real
# file in the dotfiles checkout; a repository keeping its own hook falls back
# to the path install.sh links. Never continue without it: a missing library
# would silently turn the gate off.
resolve_doc_check_lib() {
    local self dir

    if [ -n "${DOC_CHECK_LIB:-}" ] && [ -r "${DOC_CHECK_LIB}" ]; then
        printf '%s\n' "$DOC_CHECK_LIB"
        return 0
    fi

    self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s\n' "${BASH_SOURCE[0]}")
    dir=$(dirname "$self")
    if [ -r "$dir/lib/doc-check.sh" ]; then
        printf '%s\n' "$dir/lib/doc-check.sh"
        return 0
    fi

    if [ -r "$HOME/.claude/git-hooks/lib/doc-check.sh" ]; then
        printf '%s\n' "$HOME/.claude/git-hooks/lib/doc-check.sh"
        return 0
    fi

    return 1
}

if ! DOC_CHECK_LIB_PATH=$(resolve_doc_check_lib); then
    printf 'pre-commit: cannot find lib/doc-check.sh; refusing to skip the gate\n' >&2
    printf '            install it with dotfiles/install-git-hooks.sh\n' >&2
    exit 1
fi

# The path is resolved at runtime, so shellcheck cannot follow it statically.
# shellcheck disable=SC1090,SC1091
. "$DOC_CHECK_LIB_PATH"

doc_check_run
